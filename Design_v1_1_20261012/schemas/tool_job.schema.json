{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessir.example/schemas/v1_1/tool_job.schema.json",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "image_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_id": {
      "enum": [
        "T1_OCR",
        "T2_FACE",
        "T3_DEPTH",
        "T4_SEGMENTATION"
      ]
    },
    "evidence_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "cache_contract": {
      "$ref": "https://harnessir.example/schemas/v1_1/cache_contract.schema.json"
    },
    "cache_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonical_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\])[A-Za-z0-9_./-]+$"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "cache_hit",
        "resource_wait",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "protocol_version",
    "job_id",
    "case_id",
    "image_id",
    "tool_id",
    "evidence_profile_id",
    "cache_contract",
    "cache_key",
    "canonical_path",
    "status",
    "attempt",
    "timeout_seconds",
    "last_error"
  ],
  "additionalProperties": false
}
