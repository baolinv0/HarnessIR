{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessir.example/schemas/v1_1/tool_payload_ocr.schema.json",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "polygon_norm": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 3
          },
          "bbox_norm": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "detection_confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "recognition_confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "ambiguous": {
            "type": "boolean"
          },
          "view_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "polygon_norm",
          "bbox_norm",
          "text",
          "detection_confidence",
          "recognition_confidence",
          "ambiguous",
          "view_id"
        ],
        "additionalProperties": false
      }
    },
    "native_result_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\])[A-Za-z0-9_./-]+$"
    }
  },
  "required": [
    "items",
    "native_result_path"
  ],
  "additionalProperties": false
}
