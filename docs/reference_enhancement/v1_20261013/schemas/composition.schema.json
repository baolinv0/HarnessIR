{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "composition.schema.json",
  "title": "Composition stage result",
  "description": "Bare stage-result payload for schema_version ref_enhance_v1; envelope identity and errors are validated separately.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "edit_prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1800
    },
    "edit_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "scope": {
            "type": "string",
            "enum": [
              "global",
              "region"
            ]
          },
          "region_in_a": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "source_gap_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "uniqueItems": true,
            "maxItems": 20,
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "priority",
          "scope",
          "region_in_a",
          "operation",
          "source_gap_ids",
          "confidence"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "scope": {
                  "const": "global"
                }
              }
            },
            "then": {
              "properties": {
                "region_in_a": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "region_in_a": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 3
    },
    "protected_content": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "composition",
              "geometry",
              "identity",
              "text",
              "scene_content"
            ]
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "asset_role": {
            "const": "prediction"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "uniqueItems": true,
            "maxItems": 20
          }
        },
        "required": [
          "kind",
          "instruction",
          "asset_role",
          "evidence_ids"
        ]
      },
      "minItems": 1,
      "maxItems": 12
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "uniqueItems": true,
      "maxItems": 20
    },
    "reference_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 12,
      "uniqueItems": true
    }
  },
  "required": [
    "edit_prompt",
    "edit_targets",
    "protected_content",
    "evidence_ids",
    "reference_limitations"
  ]
}
