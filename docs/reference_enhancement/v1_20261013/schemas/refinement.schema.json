{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "refinement.schema.json",
  "title": "Refinement stage result",
  "description": "Bare stage-result payload for schema_version ref_enhance_v1; envelope identity and errors are validated separately.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "edit_prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1800
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "previous_instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "revised_instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "based_on_issue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "priority",
          "previous_instruction",
          "revised_instruction",
          "reason",
          "based_on_issue"
        ]
      },
      "minItems": 1,
      "maxItems": 3
    },
    "retry_focus": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 3,
      "uniqueItems": true
    },
    "source_round": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "edit_prompt",
    "changes",
    "retry_focus",
    "source_round"
  ]
}
