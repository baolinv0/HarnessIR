{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessir.example/schemas/v1/asset.schema.json",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\])[A-Za-z0-9_./-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "enum": [
        "photo",
        "map",
        "overlay",
        "raw_data",
        "json",
        "text"
      ]
    },
    "width": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "height": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  },
  "required": [
    "path",
    "sha256",
    "kind",
    "width",
    "height"
  ],
  "additionalProperties": false
}
