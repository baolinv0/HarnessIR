{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessir.example/schemas/v1/response.schema.json",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "role": {
      "enum": [
        "diagnose",
        "compose",
        "execute",
        "verify",
        "refine"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "expected_state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "payload": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "model_display_name": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version_source": {
          "enum": [
            "observed",
            "not_exposed"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "transport_mode": {
          "enum": [
            "file",
            "clipboard_import"
          ]
        },
        "writer": {
          "enum": [
            "local_work",
            "manual_import",
            "supported_bridge"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "model_display_name",
        "model_version",
        "model_version_source",
        "session_id",
        "transport_mode",
        "writer",
        "started_at",
        "completed_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol_version",
    "task_id",
    "case_id",
    "role",
    "round",
    "expected_state_revision",
    "input_sha256",
    "status",
    "payload",
    "error",
    "provenance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "null"
          },
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object"
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "diagnose"
          },
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "role",
          "status"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://harnessir.example/schemas/v1/diagnosis.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "compose"
          },
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "role",
          "status"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://harnessir.example/schemas/v1/composition.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "refine"
          },
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "role",
          "status"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://harnessir.example/schemas/v1/composition.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "execute"
          },
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "role",
          "status"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://harnessir.example/schemas/v1/execution.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "verify"
          },
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "role",
          "status"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://harnessir.example/schemas/v1/verification.schema.json"
          }
        }
      }
    }
  ]
}
